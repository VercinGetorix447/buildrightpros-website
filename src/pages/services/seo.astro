---
import Base from '../../layouts/Base.astro';
---
<Base title="SEO for Contractors | BuildRightPros">

  <!-- HERO: ATTENTION -->
  <section class="svc-hero">
    <div class="svc-hero-bg" style="background: linear-gradient(135deg, #16001e 0%, #3d0066 50%, #7b00d4 100%);"></div>
    <div class="svc-hero-content">
      <span class="svc-hero-label">SEO</span>
      <h1 class="svc-hero-headline">Show Up First.<br>Get Called First.</h1>
      <p class="svc-hero-tagline">If you're not on page one of Google for your trade and your city, your competitors are taking calls you should be getting. Let's change that.</p>
      <div class="svc-hero-btns">
        <a href="/#contact" class="btn-primary">Get Started</a>
        <a href="#interest" class="btn-secondary">Learn More</a>
      </div>
    </div>
  </section>

  <!-- INTEREST: Problem Section -->
  <section id="interest" class="svc-interest bg-cream">
    <div class="svc-inner">
      <span class="svc-section-label">The Problem</span>
      <h2 class="svc-section-heading">If You're Not on Page One of Google, You Don't Exist</h2>
      <div class="svc-interest-body">
        <p>Fewer than 1% of searchers click to page two of Google results. When a homeowner searches "HVAC repair [your city]" or "plumber near me," the contractors on page one split the overwhelming majority of that traffic. The ones on page two — or not ranked at all — get nothing, regardless of how good their work is.</p>
        <p>Most contractors rely entirely on word of mouth and referrals. That works until it doesn't — until a slow season hits, a key referral source moves away, or a competitor with a strong online presence starts eating into your market. SEO is the infrastructure that keeps leads coming in even when your network goes quiet.</p>
        <p>We start with data: a keyword report that shows you exactly which terms your target customers are searching, which competitors rank for them, and what it will take to break into the top positions. From that foundation, we build a content and optimization roadmap to systematically move you up the results page — and keep you there.</p>
      </div>
    </div>
  </section>

  <!-- DESIRE: Feature Cards -->
  <section class="svc-desire bg-warm">
    <div class="svc-inner">
      <span class="svc-section-label">What You Get</span>
      <h2 class="svc-section-heading">Real Data. Real Rankings. Real Leads.</h2>
      <div class="svc-cards">
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3>Keyword Report</h3>
          <p>We research exactly what your customers are typing into Google — by trade, by service, by city and suburb — and deliver a prioritized list of the terms most likely to generate qualified calls and leads.</p>
        </div>
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Competitor Research</h3>
          <p>We analyze who ranks above you, what content they have that you don't, where they get their backlinks from, and what gaps exist in the market you can exploit to take rankings faster than starting from scratch.</p>
        </div>
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3>Content Optimization Roadmap</h3>
          <p>You get a prioritized action plan — which pages to update, which new pages to create, which local signals to add — with estimated impact for each item so you can execute in order of highest return.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING SECTION -->
  <section class="svc-pricing bg-cream">
    <div class="svc-inner">
      <span class="svc-section-label">Pricing</span>
      <h2 class="svc-section-heading">SEO Reports — Flat Rate, Instant Delivery</h2>
      <p class="svc-pricing-sub">No monthly retainer required to get started. Pick the report that fits your goal.</p>
      <div class="svc-pricing-cards">
        <div class="svc-price-card">
          <div class="svc-price-tier">Starter</div>
          <div class="svc-price-amount">$19</div>
          <div class="svc-price-desc">1 Keyword Group</div>
          <ul class="svc-price-list">
            <li>Single trade + city focus</li>
            <li>Top 10 keyword targets</li>
            <li>Monthly search volume</li>
            <li>Difficulty ratings</li>
            <li>Delivered within 48 hours</li>
          </ul>
          <a href="/#contact" class="btn-price">Get Starter Report</a>
        </div>
        <div class="svc-price-card featured">
          <div class="svc-price-badge">Most Popular</div>
          <div class="svc-price-tier">Pro</div>
          <div class="svc-price-amount">$99</div>
          <div class="svc-price-desc">Full Analysis</div>
          <ul class="svc-price-list">
            <li>Full keyword map — all services</li>
            <li>Competitor keyword gap analysis</li>
            <li>Suggested article titles (content plan)</li>
            <li>Domain authority assessment</li>
            <li>Local search opportunity report</li>
            <li>Delivered within 72 hours</li>
          </ul>
          <a href="/#contact" class="btn-price primary">Get Pro Report</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ACTION: CTA -->
  <section class="svc-action">
    <div class="svc-inner svc-action-inner">
      <h2 class="svc-action-headline">Get My SEO Report</h2>
      <p class="svc-action-sub">Start with data — not guesswork. See exactly where you stand, where the opportunity is, and what it will take to own page one in your market.</p>
      <div class="svc-action-btns">
        <a href="/#contact" class="btn-primary">Buy Now</a>
        <a href="https://cal.com/buildrightpros.com/60-min-meeting" target="_blank" rel="noopener" class="btn-outline-light">Book a Demo</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .svc-hero { position: relative; min-height: 520px; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; }
  .svc-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .svc-hero-content { position: relative; z-index: 1; max-width: 800px; padding: 4rem 2rem; }
  .svc-hero-label { display: inline-block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); background: rgba(255,255,255,0.1); padding: 0.35rem 1rem; border-radius: 50px; margin-bottom: 1.25rem; }
  .svc-hero-headline { font-family: 'Titan One', cursive; font-size: clamp(2.2rem, 5vw, 3.5rem); color: #fff; line-height: 1.1; margin-bottom: 1.25rem; text-transform: uppercase; }
  .svc-hero-tagline { font-size: 1.15rem; color: rgba(255,255,255,0.82); line-height: 1.7; margin-bottom: 2.25rem; max-width: 600px; margin-left: auto; margin-right: auto; }
  .svc-hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .btn-primary { display: inline-block; background: var(--accent); color: #fff; font-weight: 700; font-size: 1rem; padding: 0.875rem 2rem; border-radius: 8px; text-decoration: none; transition: background 0.2s, transform 0.2s; }
  .btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); }
  .btn-secondary { display: inline-block; background: rgba(255,255,255,0.12); color: #fff; font-weight: 600; font-size: 1rem; padding: 0.875rem 2rem; border-radius: 8px; text-decoration: none; border: 1px solid rgba(255,255,255,0.35); transition: background 0.2s, transform 0.2s; }
  .btn-secondary:hover { background: rgba(255,255,255,0.22); transform: translateY(-2px); }
  .btn-outline-light { display: inline-block; background: transparent; color: #fff; font-weight: 700; font-size: 1rem; padding: 0.875rem 2rem; border-radius: 8px; text-decoration: none; border: 2px solid rgba(255,255,255,0.6); transition: background 0.2s, transform 0.2s; }
  .btn-outline-light:hover { background: rgba(255,255,255,0.12); transform: translateY(-2px); }

  .svc-inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
  .bg-cream { background: var(--bg-main); }
  .bg-warm  { background: var(--bg-alt); }

  .svc-interest { padding: 5rem 2rem; }
  .svc-section-label { display: block; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); margin-bottom: 0.75rem; }
  .svc-section-heading { font-family: 'Titan One', cursive; font-size: clamp(1.6rem, 3vw, 2.25rem); color: var(--dark); text-transform: uppercase; margin-bottom: 2rem; line-height: 1.2; }
  .svc-interest-body { display: grid; gap: 1.25rem; max-width: 820px; }
  .svc-interest-body p { color: var(--text); line-height: 1.8; font-size: 1rem; }

  .svc-desire { padding: 5rem 2rem; }
  .svc-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; margin-top: 2.5rem; }
  .svc-card { background: #fff; border: 1px solid var(--dark); border-radius: 12px; padding: 2rem; transition: transform 0.3s, box-shadow 0.3s; }
  .svc-card:hover { transform: translateY(-4px); box-shadow: 0 12px 35px rgba(0,0,0,0.09); }
  .svc-card-icon { width: 52px; height: 52px; background: var(--bg-main); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; }
  .svc-card-icon svg { width: 26px; height: 26px; color: var(--accent); }
  .svc-card h3 { font-family: 'Titan One', cursive; font-size: 1.1rem; color: var(--dark); margin-bottom: 0.75rem; text-transform: uppercase; }
  .svc-card p { color: var(--text); font-size: 0.93rem; line-height: 1.7; }

  /* PRICING */
  .svc-pricing { padding: 5rem 2rem; }
  .svc-pricing-sub { color: var(--text-light); font-size: 1rem; margin-bottom: 2.5rem; }
  .svc-pricing-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; max-width: 700px; margin-top: 2rem; }
  .svc-price-card { background: #fff; border: 1px solid var(--dark); border-radius: 14px; padding: 2.25rem; position: relative; display: flex; flex-direction: column; gap: 0.5rem; }
  .svc-price-card.featured { border: 2px solid var(--accent); box-shadow: 0 8px 30px rgba(0,0,0,0.1); }
  .svc-price-badge { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: var(--section-head); color: #fff; font-size: 0.7rem; font-weight: 700; padding: 0.3rem 1rem; border-radius: 20px; text-transform: uppercase; white-space: nowrap; }
  .svc-price-tier { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); }
  .svc-price-amount { font-family: 'Titan One', cursive; font-size: 3rem; color: var(--dark); line-height: 1; }
  .svc-price-desc { font-size: 0.9rem; color: var(--text-light); margin-bottom: 1rem; }
  .svc-price-list { list-style: none; padding: 0; margin: 0 0 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; flex-grow: 1; }
  .svc-price-list li { font-size: 0.88rem; color: var(--text); padding-left: 1.25rem; position: relative; }
  .svc-price-list li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }
  .btn-price { display: block; text-align: center; padding: 0.75rem; border-radius: 8px; font-weight: 700; font-size: 0.9rem; text-decoration: none; background: var(--dark); color: #fff; transition: background 0.2s; margin-top: auto; }
  .btn-price:hover { background: #333; }
  .btn-price.primary { background: var(--accent); }
  .btn-price.primary:hover { background: var(--accent-hover); }

  .svc-action { background: linear-gradient(135deg, var(--dark) 0%, var(--section-head) 100%); padding: 5rem 2rem; text-align: center; }
  .svc-action-headline { font-family: 'Titan One', cursive; font-size: clamp(1.8rem, 3.5vw, 2.75rem); color: #fff; text-transform: uppercase; margin-bottom: 1rem; }
  .svc-action-sub { color: rgba(255,255,255,0.78); font-size: 1.1rem; line-height: 1.7; margin-bottom: 2.25rem; max-width: 600px; margin-left: auto; margin-right: auto; }
  .svc-action-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 768px) {
    .svc-cards { grid-template-columns: 1fr; }
    .svc-pricing-cards { grid-template-columns: 1fr; }
    .svc-hero-headline { font-size: 2rem; }
  }
</style>
