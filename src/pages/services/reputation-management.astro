---
import Base from '../../layouts/Base.astro';
---
<Base title="Reputation Management for Contractors | BuildRightPros">

  <!-- HERO: ATTENTION -->
  <section class="svc-hero">
    <div class="svc-hero-bg" style="background: linear-gradient(135deg, #0d1b2a 0%, #1b263b 50%, #415a77 100%);"></div>
    <div class="svc-hero-content">
      <span class="svc-hero-label">Reputation Management</span>
      <h1 class="svc-hero-headline">Your Reputation Is Your<br>Best Salesperson</h1>
      <p class="svc-hero-tagline">One bad review — or a blank profile — costs you jobs every week. We audit, protect, and grow your online presence so you win the trust battle before the phone ever rings.</p>
      <div class="svc-hero-btns">
        <a href="/#contact" class="btn-primary">Get Started</a>
        <a href="#interest" class="btn-secondary">Learn More</a>
      </div>
    </div>
  </section>

  <!-- INTEREST: Problem Section -->
  <section id="interest" class="svc-interest bg-cream">
    <div class="svc-inner">
      <span class="svc-section-label">The Problem</span>
      <h2 class="svc-section-heading">87% of Customers Check Reviews Before Calling — Most Contractors Ignore This</h2>
      <div class="svc-interest-body">
        <p>Before a homeowner picks up the phone, they've already decided whether you're worth calling. They check Google, look at your star rating, scroll your reviews, and see if you've bothered to respond to feedback. If what they find is outdated, sparse, or negative — they close the tab and call the next contractor.</p>
        <p>Most contractors don't realize they have a reputation problem until business starts slowing down. By then, a competitor with 80 five-star reviews has already taken the market. The gap between a 3.8-star profile and a 4.7-star profile isn't just perception — it's dollars. Businesses with stronger review profiles consistently convert more searchers into callers at a significantly lower cost per lead.</p>
        <p>Our reputation management service starts with a comprehensive audit of your entire digital presence — Google Business Profile, BBB listing, Facebook, Yelp, and beyond. We identify exactly what's hurting you, what's missing, and what needs to be fixed. Then we build a plan to close those gaps and systematically grow your verified review count.</p>
      </div>
    </div>
  </section>

  <!-- DESIRE: Feature Cards -->
  <section class="svc-desire bg-warm">
    <div class="svc-inner">
      <span class="svc-section-label">What You Get</span>
      <h2 class="svc-section-heading">A Full Picture of Your Online Standing</h2>
      <div class="svc-cards">
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>GMB Audit</h3>
          <p>We do a line-by-line review of your Google Business Profile — photos, categories, hours, services, Q&amp;A, and review responses — and tell you exactly what's costing you clicks and calls.</p>
        </div>
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h3>Review Gap Analysis</h3>
          <p>We compare your review volume and star rating against your top 5 local competitors, identify where you're losing the trust battle, and prioritize the highest-impact improvements to close the gap fast.</p>
        </div>
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h3>BBB + Social Presence Check</h3>
          <p>Beyond Google, we audit your BBB accreditation status, Facebook rating, and Yelp profile — giving you a complete picture of how customers see you across every major trust platform.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ENGAGEMENT NOTE -->
  <section class="svc-note bg-cream">
    <div class="svc-inner">
      <div class="svc-note-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <div>
          <strong>Custom Pricing Per Engagement</strong>
          <p>Every reputation situation is different. We review your current standing before quoting a single dollar — no guesswork, no locked-in packages that don't fit your reality.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ACTION: CTA -->
  <section class="svc-action">
    <div class="svc-inner svc-action-inner">
      <h2 class="svc-action-headline">Get Your Free Reputation Audit</h2>
      <p class="svc-action-sub">We'll show you exactly how customers see you online — and what it's costing you — at no charge.</p>
      <div class="svc-action-btns">
        <a href="/#contact" class="btn-primary">Buy Now</a>
        <a href="https://cal.com/buildrightpros.com/60-min-meeting" target="_blank" rel="noopener" class="btn-outline-light">Book a Demo</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .svc-hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }
  .svc-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .svc-hero-content { position: relative; z-index: 1; max-width: 800px; padding: 4rem 2rem; }
  .svc-hero-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    background: rgba(255,255,255,0.1);
    padding: 0.35rem 1rem;
    border-radius: 50px;
    margin-bottom: 1.25rem;
  }
  .svc-hero-headline {
    font-family: 'Titan One', cursive;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    color: #fff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }
  .svc-hero-tagline {
    font-size: 1.15rem;
    color: rgba(255,255,255,0.82);
    line-height: 1.7;
    margin-bottom: 2.25rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .svc-hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .btn-primary {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.875rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); }
  .btn-secondary {
    display: inline-block;
    background: rgba(255,255,255,0.12);
    color: #fff;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.875rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.35);
    transition: background 0.2s, transform 0.2s;
  }
  .btn-secondary:hover { background: rgba(255,255,255,0.22); transform: translateY(-2px); }
  .btn-outline-light {
    display: inline-block;
    background: transparent;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.875rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    border: 2px solid rgba(255,255,255,0.6);
    transition: background 0.2s, transform 0.2s;
  }
  .btn-outline-light:hover { background: rgba(255,255,255,0.12); transform: translateY(-2px); }

  .svc-inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
  .bg-cream { background: var(--bg-main); }
  .bg-warm  { background: var(--bg-alt); }

  .svc-interest { padding: 5rem 2rem; }
  .svc-section-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .svc-section-heading {
    font-family: 'Titan One', cursive;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    color: var(--dark);
    text-transform: uppercase;
    margin-bottom: 2rem;
    line-height: 1.2;
  }
  .svc-interest-body { display: grid; gap: 1.25rem; max-width: 820px; }
  .svc-interest-body p { color: var(--text); line-height: 1.8; font-size: 1rem; }

  .svc-desire { padding: 5rem 2rem; }
  .svc-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; margin-top: 2.5rem; }
  .svc-card {
    background: #fff;
    border: 1px solid var(--dark);
    border-radius: 12px;
    padding: 2rem;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .svc-card:hover { transform: translateY(-4px); box-shadow: 0 12px 35px rgba(0,0,0,0.09); }
  .svc-card-icon {
    width: 52px; height: 52px;
    background: var(--bg-main);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1.25rem;
  }
  .svc-card-icon svg { width: 26px; height: 26px; color: var(--accent); }
  .svc-card h3 {
    font-family: 'Titan One', cursive;
    font-size: 1.1rem;
    color: var(--dark);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }
  .svc-card p { color: var(--text); font-size: 0.93rem; line-height: 1.7; }

  .svc-note { padding: 3rem 2rem; }
  .svc-note-box {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: #fff;
    border: 1px solid var(--dark);
    border-left: 4px solid var(--accent);
    border-radius: 10px;
    padding: 1.75rem;
    max-width: 700px;
  }
  .svc-note-box svg { width: 28px; height: 28px; color: var(--accent); flex-shrink: 0; margin-top: 2px; }
  .svc-note-box strong { display: block; font-size: 1rem; color: var(--dark); margin-bottom: 0.4rem; }
  .svc-note-box p { color: var(--text); font-size: 0.93rem; line-height: 1.6; margin: 0; }

  .svc-action {
    background: linear-gradient(135deg, var(--dark) 0%, var(--section-head) 100%);
    padding: 5rem 2rem;
    text-align: center;
  }
  .svc-action-headline {
    font-family: 'Titan One', cursive;
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    color: #fff;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .svc-action-sub {
    color: rgba(255,255,255,0.78);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2.25rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .svc-action-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 768px) {
    .svc-cards { grid-template-columns: 1fr; }
    .svc-hero-headline { font-size: 2rem; }
    .svc-note-box { flex-direction: column; }
  }
</style>
