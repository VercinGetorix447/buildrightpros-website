---
import Base from '../../layouts/Base.astro';
---
<Base title="CRM for Contractors | BuildRightPros">

  <!-- HERO: ATTENTION -->
  <section class="svc-hero">
    <div class="svc-hero-bg" style="background: linear-gradient(135deg, #1a0a00 0%, #7a3900 50%, #c05c00 100%);"></div>
    <div class="svc-hero-content">
      <span class="svc-hero-label">CRM</span>
      <h1 class="svc-hero-headline">Know Every Lead.<br>Close More Jobs.</h1>
      <p class="svc-hero-tagline">Stop managing jobs in your head or in a scattered spreadsheet. Our contractor CRM gives you a single command center for every lead, every customer, and every deal in your pipeline.</p>
      <div class="svc-hero-btns">
        <a href="/#contact" class="btn-primary">Get Started</a>
        <a href="#interest" class="btn-secondary">Learn More</a>
      </div>
    </div>
  </section>

  <!-- INTEREST: Problem Section -->
  <section id="interest" class="svc-interest bg-cream">
    <div class="svc-inner">
      <span class="svc-section-label">The Problem</span>
      <h2 class="svc-section-heading">Contractors Lose Jobs Not Because They Can't Do the Work — But Because They Can't Track It</h2>
      <div class="svc-interest-body">
        <p>A lead calls on Monday. You write their number on a sticky note. Wednesday you're slammed with a job and forget to call back. By Friday they've hired someone else. This happens dozens of times a year at most contractor businesses — not because the contractor is bad, but because there's no system to track where every lead is and what the next step is.</p>
        <p>The same problem kills repeat business. A customer you worked with 18 months ago needs their HVAC serviced again — but because there's no record of the relationship, no follow-up was ever triggered, and they found a different contractor through Google. Meanwhile, you're spending money on ads to find new customers when your best source of revenue is sitting untouched in a pile of old invoices.</p>
        <p>A CRM built for contractors changes this. Every lead has a card. Every card has a stage. Every stage has a next action. You see at a glance who needs a call, who needs an estimate, who's waiting on a proposal, and who's ready to schedule — without holding any of it in your head. Our platform grows with you, from a simple table and kanban view all the way to a fully managed marketing and automation engine.</p>
      </div>
    </div>
  </section>

  <!-- DESIRE: Feature Cards -->
  <section class="svc-desire bg-warm">
    <div class="svc-inner">
      <span class="svc-section-label">What You Get</span>
      <h2 class="svc-section-heading">Every Lead Tracked. Every Customer Remembered. Every Deal Visible.</h2>
      <div class="svc-cards">
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
          </div>
          <h3>Customer Table + Kanban Pipeline</h3>
          <p>View all your leads in a sortable table or drag-and-drop kanban board — new inquiry, estimate sent, proposal, won, lost. Move deals through stages with one click and always know who needs your attention today.</p>
        </div>
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h3>Email Marketing + Landing Pages</h3>
          <p>Send targeted campaigns to past customers for seasonal tune-ups, referral requests, or promotions. Includes one custom landing page per month and social posting to 3 platforms — all coordinated from one dashboard.</p>
        </div>
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </div>
          <h3>Full Managed Platform</h3>
          <p>Our Enterprise tier gives you a fully managed marketing and operations platform — we configure it, maintain it, and optimize it for you. Built on the same infrastructure as our $3,699 Scale Package setup.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING SECTION -->
  <section class="svc-pricing bg-cream">
    <div class="svc-inner">
      <span class="svc-section-label">Pricing</span>
      <h2 class="svc-section-heading">Simple Monthly Plans. Cancel Anytime.</h2>
      <p class="svc-pricing-sub">Start with what you need today. Upgrade as you grow.</p>
      <div class="crm-pricing-grid">

        <!-- STARTER -->
        <div class="crm-price-card">
          <div class="crm-price-tier">Starter</div>
          <div class="crm-price-amount">$49<span>/mo</span></div>
          <p class="crm-price-tagline">For contractors ready to get organized</p>
          <ul class="crm-price-list">
            <li>Customer database table</li>
            <li>Kanban deal pipeline</li>
            <li>Lead stage tracking</li>
            <li>Contact notes + history</li>
            <li>Mobile-friendly dashboard</li>
          </ul>
          <a href="/#contact" class="btn-crm">Start With Starter</a>
        </div>

        <!-- GROWTH -->
        <div class="crm-price-card featured">
          <div class="crm-price-badge">Most Popular</div>
          <div class="crm-price-tier">Growth</div>
          <div class="crm-price-amount">$149<span>/mo</span></div>
          <p class="crm-price-tagline">For contractors building a repeat customer engine</p>
          <ul class="crm-price-list">
            <li>Everything in Starter, plus:</li>
            <li>Email marketing campaigns</li>
            <li>1 custom landing page per month</li>
            <li>Social posting to 3 platforms</li>
            <li>Automated follow-up sequences</li>
            <li>Campaign analytics dashboard</li>
          </ul>
          <a href="/#contact" class="btn-crm primary">Start Growth Plan</a>
        </div>

        <!-- ENTERPRISE -->
        <div class="crm-price-card">
          <div class="crm-price-tier">Enterprise Managed</div>
          <div class="crm-price-amount">$296<span>/mo</span></div>
          <p class="crm-price-tagline">Full managed platform — we run it for you</p>
          <ul class="crm-price-list">
            <li>Everything in Growth, plus:</li>
            <li>Dedicated account manager</li>
            <li>Monthly strategy calls</li>
            <li>Full platform configuration</li>
            <li>Custom workflow automations</li>
            <li>Priority support</li>
            <li>Built on our $3,699 Scale setup</li>
          </ul>
          <a href="https://cal.com/buildrightpros.com/60-min-meeting" target="_blank" rel="noopener" class="btn-crm">Book Enterprise Call</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ACTION: CTA -->
  <section class="svc-action">
    <div class="svc-inner svc-action-inner">
      <h2 class="svc-action-headline">Know Every Lead. Close More Jobs.</h2>
      <p class="svc-action-sub">Start with the Starter plan and upgrade when you're ready. No long-term contracts. Your data, your pipeline, your business — organized and running.</p>
      <div class="svc-action-btns">
        <a href="/#contact" class="btn-primary">Start With Starter</a>
        <a href="https://cal.com/buildrightpros.com/60-min-meeting" target="_blank" rel="noopener" class="btn-outline-light">Book a Demo</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .svc-hero { position: relative; min-height: 520px; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; }
  .svc-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .svc-hero-content { position: relative; z-index: 1; max-width: 800px; padding: 4rem 2rem; }
  .svc-hero-label { display: inline-block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); background: rgba(255,255,255,0.1); padding: 0.35rem 1rem; border-radius: 50px; margin-bottom: 1.25rem; }
  .svc-hero-headline { font-family: 'Titan One', cursive; font-size: clamp(2.2rem, 5vw, 3.5rem); color: #fff; line-height: 1.1; margin-bottom: 1.25rem; text-transform: uppercase; }
  .svc-hero-tagline { font-size: 1.15rem; color: rgba(255,255,255,0.82); line-height: 1.7; margin-bottom: 2.25rem; max-width: 600px; margin-left: auto; margin-right: auto; }
  .svc-hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .btn-primary { display: inline-block; background: var(--accent); color: #fff; font-weight: 700; font-size: 1rem; padding: 0.875rem 2rem; border-radius: 8px; text-decoration: none; transition: background 0.2s, transform 0.2s; }
  .btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); }
  .btn-secondary { display: inline-block; background: rgba(255,255,255,0.12); color: #fff; font-weight: 600; font-size: 1rem; padding: 0.875rem 2rem; border-radius: 8px; text-decoration: none; border: 1px solid rgba(255,255,255,0.35); transition: background 0.2s, transform 0.2s; }
  .btn-secondary:hover { background: rgba(255,255,255,0.22); transform: translateY(-2px); }
  .btn-outline-light { display: inline-block; background: transparent; color: #fff; font-weight: 700; font-size: 1rem; padding: 0.875rem 2rem; border-radius: 8px; text-decoration: none; border: 2px solid rgba(255,255,255,0.6); transition: background 0.2s, transform 0.2s; }
  .btn-outline-light:hover { background: rgba(255,255,255,0.12); transform: translateY(-2px); }

  .svc-inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
  .bg-cream { background: var(--bg-main); }
  .bg-warm  { background: var(--bg-alt); }

  .svc-interest { padding: 5rem 2rem; }
  .svc-section-label { display: block; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); margin-bottom: 0.75rem; }
  .svc-section-heading { font-family: 'Titan One', cursive; font-size: clamp(1.6rem, 3vw, 2.25rem); color: var(--dark); text-transform: uppercase; margin-bottom: 2rem; line-height: 1.2; }
  .svc-interest-body { display: grid; gap: 1.25rem; max-width: 820px; }
  .svc-interest-body p { color: var(--text); line-height: 1.8; font-size: 1rem; }

  .svc-desire { padding: 5rem 2rem; }
  .svc-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; margin-top: 2.5rem; }
  .svc-card { background: #fff; border: 1px solid var(--dark); border-radius: 12px; padding: 2rem; transition: transform 0.3s, box-shadow 0.3s; }
  .svc-card:hover { transform: translateY(-4px); box-shadow: 0 12px 35px rgba(0,0,0,0.09); }
  .svc-card-icon { width: 52px; height: 52px; background: var(--bg-main); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; }
  .svc-card-icon svg { width: 26px; height: 26px; color: var(--accent); }
  .svc-card h3 { font-family: 'Titan One', cursive; font-size: 1.1rem; color: var(--dark); margin-bottom: 0.75rem; text-transform: uppercase; }
  .svc-card p { color: var(--text); font-size: 0.93rem; line-height: 1.7; }

  /* CRM PRICING */
  .svc-pricing { padding: 5rem 2rem; }
  .svc-pricing-sub { color: var(--text-light); font-size: 1rem; margin-bottom: 2.5rem; }
  .crm-pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 2rem; }
  .crm-price-card { background: #fff; border: 1px solid var(--dark); border-radius: 14px; padding: 2.25rem; position: relative; display: flex; flex-direction: column; }
  .crm-price-card.featured { border: 2px solid var(--accent); box-shadow: 0 8px 30px rgba(0,0,0,0.1); }
  .crm-price-badge { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: var(--section-head); color: #fff; font-size: 0.7rem; font-weight: 700; padding: 0.3rem 1rem; border-radius: 20px; text-transform: uppercase; white-space: nowrap; }
  .crm-price-tier { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); margin-bottom: 0.5rem; }
  .crm-price-amount { font-family: 'Titan One', cursive; font-size: 2.75rem; color: var(--dark); line-height: 1; margin-bottom: 0.25rem; }
  .crm-price-amount span { font-family: inherit; font-size: 1rem; font-weight: 400; color: var(--text-light); }
  .crm-price-tagline { font-size: 0.85rem; color: var(--text-light); margin-bottom: 1.25rem; line-height: 1.5; }
  .crm-price-list { list-style: none; padding: 0; margin: 0 0 1.75rem; display: flex; flex-direction: column; gap: 0.6rem; flex-grow: 1; }
  .crm-price-list li { font-size: 0.88rem; color: var(--text); padding-left: 1.25rem; position: relative; line-height: 1.5; }
  .crm-price-list li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }
  .crm-price-list li:first-child::before { content: ''; }
  .btn-crm { display: block; text-align: center; padding: 0.8rem; border-radius: 8px; font-weight: 700; font-size: 0.9rem; text-decoration: none; background: var(--dark); color: #fff; transition: background 0.2s; margin-top: auto; }
  .btn-crm:hover { background: #333; }
  .btn-crm.primary { background: var(--accent); }
  .btn-crm.primary:hover { background: var(--accent-hover); }

  .svc-action { background: linear-gradient(135deg, var(--dark) 0%, var(--section-head) 100%); padding: 5rem 2rem; text-align: center; }
  .svc-action-headline { font-family: 'Titan One', cursive; font-size: clamp(1.8rem, 3.5vw, 2.75rem); color: #fff; text-transform: uppercase; margin-bottom: 1rem; }
  .svc-action-sub { color: rgba(255,255,255,0.78); font-size: 1.1rem; line-height: 1.7; margin-bottom: 2.25rem; max-width: 600px; margin-left: auto; margin-right: auto; }
  .svc-action-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 1024px) { .crm-pricing-grid { grid-template-columns: 1fr; max-width: 440px; } }
  @media (max-width: 768px) {
    .svc-cards { grid-template-columns: 1fr; }
    .svc-hero-headline { font-size: 2rem; }
    .crm-pricing-grid { grid-template-columns: 1fr; max-width: 100%; }
  }
</style>
