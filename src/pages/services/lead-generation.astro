---
import Base from '../../layouts/Base.astro';
---
<Base title="Lead Generation for Contractors | BuildRightPros">

  <!-- HERO: ATTENTION -->
  <section class="svc-hero">
    <div class="svc-hero-bg" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);"></div>
    <div class="svc-hero-content">
      <span class="svc-hero-label">Lead Generation</span>
      <h1 class="svc-hero-headline">Stop Chasing Leads.<br>Start Closing Them.</h1>
      <p class="svc-hero-tagline">We find, score, and deliver qualified prospects in your service area — ready to hear from you today.</p>
      <div class="svc-hero-btns">
        <a href="/#contact" class="btn-primary">Get Started</a>
        <a href="#interest" class="btn-secondary">Learn More</a>
      </div>
    </div>
  </section>

  <!-- INTEREST: Problem Section -->
  <section id="interest" class="svc-interest bg-cream">
    <div class="svc-inner">
      <span class="svc-section-label">The Problem</span>
      <h2 class="svc-section-heading">Contractors Miss 40%+ of Their Best Leads Every Week</h2>
      <div class="svc-interest-body">
        <p>Most contractors are too busy on the job to be watching their inbox or phone for new opportunities. By the time you call back, the lead has already hired someone else. That's not a skill problem — it's a system problem.</p>
        <p>Speed-to-contact is the single biggest factor in lead conversion. Studies consistently show that calling a lead within 5 minutes makes you 9x more likely to connect and 21x more likely to qualify them. Without a lead delivery system, you're handing money to your competitors every single day.</p>
        <p>Our lead generation platform sources, validates, and ranks prospects in your specific trade and service area. You don't search — we deliver. You spend your time on calls that convert, not on cold outreach that wastes your afternoon.</p>
      </div>
    </div>
  </section>

  <!-- DESIRE: Feature Cards -->
  <section class="svc-desire bg-warm">
    <div class="svc-inner">
      <span class="svc-section-label">What You Get</span>
      <h2 class="svc-section-heading">Everything You Need to Close More Jobs</h2>
      <div class="svc-cards">
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </div>
          <h3>Targeted Prospect Lists</h3>
          <p>We build hyper-local prospect lists filtered by trade, geography, and buying signals — so every lead you get is in your wheelhouse and ready to buy.</p>
        </div>
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3>Automated Scoring + Ranking</h3>
          <p>Not all leads are equal. Our system scores each prospect by intent, urgency, and fit — so you always know who to call first for the fastest close.</p>
        </div>
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 015.11 12.88a19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          </div>
          <h3>Delivered Ready to Call</h3>
          <p>Each lead report lands in your inbox or CRM with name, number, context, and a recommended opening — so you can pick up the phone confident and prepared.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ACTION: CTA -->
  <section class="svc-action">
    <div class="svc-inner svc-action-inner">
      <h2 class="svc-action-headline">Get Your First Lead Report</h2>
      <p class="svc-action-sub">See exactly what qualified prospects exist in your market — before you commit to anything.</p>
      <div class="svc-action-btns">
        <a href="/#contact" class="btn-primary btn-lg">Buy Now</a>
        <a href="https://cal.com/buildrightpros.com/60-min-meeting" target="_blank" rel="noopener" class="btn-outline-light btn-lg">Book a Demo</a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ===== SHARED SERVICE PAGE STYLES ===== */
  .svc-hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .svc-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .svc-hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    padding: 4rem 2rem;
  }

  .svc-hero-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    background: rgba(255,255,255,0.1);
    padding: 0.35rem 1rem;
    border-radius: 50px;
    margin-bottom: 1.25rem;
  }

  .svc-hero-headline {
    font-family: 'Titan One', cursive;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    color: #fff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .svc-hero-tagline {
    font-size: 1.15rem;
    color: rgba(255,255,255,0.82);
    line-height: 1.7;
    margin-bottom: 2.25rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .svc-hero-btns {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ===== BUTTONS ===== */
  .btn-primary {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.875rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); }

  .btn-secondary {
    display: inline-block;
    background: rgba(255,255,255,0.12);
    color: #fff;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.875rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.35);
    transition: background 0.2s, transform 0.2s;
  }
  .btn-secondary:hover { background: rgba(255,255,255,0.22); transform: translateY(-2px); }

  .btn-outline-light {
    display: inline-block;
    background: transparent;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.875rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    border: 2px solid rgba(255,255,255,0.6);
    transition: background 0.2s, transform 0.2s;
  }
  .btn-outline-light:hover { background: rgba(255,255,255,0.12); transform: translateY(-2px); }

  .btn-lg { padding: 1rem 2.5rem; font-size: 1.05rem; }

  /* ===== LAYOUT ===== */
  .svc-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .bg-cream { background: var(--bg-main); }
  .bg-warm  { background: var(--bg-alt); }

  /* ===== INTEREST SECTION ===== */
  .svc-interest { padding: 5rem 2rem; }

  .svc-section-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .svc-section-heading {
    font-family: 'Titan One', cursive;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    color: var(--dark);
    text-transform: uppercase;
    margin-bottom: 2rem;
    line-height: 1.2;
  }

  .svc-interest-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 820px;
  }

  .svc-interest-body p {
    color: var(--text);
    line-height: 1.8;
    font-size: 1rem;
  }

  /* ===== DESIRE / CARDS ===== */
  .svc-desire { padding: 5rem 2rem; }

  .svc-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-top: 2.5rem;
  }

  .svc-card {
    background: #fff;
    border: 1px solid var(--dark);
    border-radius: 12px;
    padding: 2rem;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .svc-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 35px rgba(0,0,0,0.09);
  }

  .svc-card-icon {
    width: 52px;
    height: 52px;
    background: var(--bg-main);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .svc-card-icon svg {
    width: 26px;
    height: 26px;
    color: var(--accent);
  }

  .svc-card h3 {
    font-family: 'Titan One', cursive;
    font-size: 1.1rem;
    color: var(--dark);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .svc-card p {
    color: var(--text);
    font-size: 0.93rem;
    line-height: 1.7;
  }

  /* ===== ACTION SECTION ===== */
  .svc-action {
    background: linear-gradient(135deg, var(--dark) 0%, var(--section-head) 100%);
    padding: 5rem 2rem;
    text-align: center;
  }

  .svc-action-inner { }

  .svc-action-headline {
    font-family: 'Titan One', cursive;
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    color: #fff;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .svc-action-sub {
    color: rgba(255,255,255,0.78);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2.25rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .svc-action-btns {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .svc-cards { grid-template-columns: 1fr; }
    .svc-hero-headline { font-size: 2rem; }
  }
</style>
